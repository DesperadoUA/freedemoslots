# freedemoslots.net — Apache/LiteSpeed front document root
# Nuxt SSR: do not add an SPA fallback rewrite to index.html.
# Application routes and /_nuxt assets are handled by the Nuxt app / proxy.

# -----------------------------------------------------------------------------
# Directory behaviour
# -----------------------------------------------------------------------------
Options -Indexes -MultiViews

# -----------------------------------------------------------------------------
# MIME: machine-readable text for AI agents
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/plain;charset=utf-8 .txt
  AddType text/markdown;charset=utf-8 .md
</IfModule>

# -----------------------------------------------------------------------------
# Rewrites: block hidden paths, then enforce the canonical origin
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Deny hidden files and directories such as .git/ and .env.
  # Keep /.well-known/ available for ACME/SSL verification.
  RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L,NC]

  # Canonical host: non-www HTTPS.
  RewriteCond %{HTTP_HOST} !^freedemoslots\.net(?::\d+)?$ [NC]
  RewriteRule ^ https://freedemoslots.net%{REQUEST_URI} [R=301,L]

  # HTTP -> HTTPS. X-Forwarded-Proto prevents loops behind Cloudflare/proxies.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https(?:,|$) [NC]
  RewriteRule ^ https://freedemoslots.net%{REQUEST_URI} [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
# Block sensitive files even when they are not hidden
# -----------------------------------------------------------------------------
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)^(?:\.env(?:\..*)?|\.gitignore|\.htaccess|\.htpasswd|\.user\.ini|\.DS_Store|\.npmrc|\.yarnrc(?:\.yml)?|composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|bun\.lockb|nuxt\.config\.(?:js|ts)|vite\.config\.(?:js|ts)|webpack\.config\.js|docker-compose(?:\.[^.]+)?\.ya?ml|Dockerfile)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "(?i)\.(?:bak|backup|old|orig|save|swp|swo|sql|sqlite|tar|tgz|gz|bz2|xz|zip|rar|7z|log)$">
    Require all denied
  </FilesMatch>
</IfModule>

# Apache 2.2 compatibility fallback.
<IfModule !mod_authz_core.c>
  <FilesMatch "(?i)^(?:\.env(?:\..*)?|\.gitignore|\.htaccess|\.htpasswd|\.user\.ini|\.DS_Store|\.npmrc|\.yarnrc(?:\.yml)?|composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|bun\.lockb|nuxt\.config\.(?:js|ts)|vite\.config\.(?:js|ts)|webpack\.config\.js|docker-compose(?:\.[^.]+)?\.ya?ml|Dockerfile)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "(?i)\.(?:bak|backup|old|orig|save|swp|swo|sql|sqlite|tar|tgz|gz|bz2|xz|zip|rar|7z|log)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/markdown
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE application/wasm
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# -----------------------------------------------------------------------------
# Browser expiry rules
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  # Dynamic HTML/JSON must be revalidated.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/ld+json "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"

  # llms.txt and similar agent files: short cache, easy to refresh.
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/markdown "access plus 1 hour"

  # XML feeds and sitemaps.
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/rss+xml "access plus 1 hour"
  ExpiresByType application/atom+xml "access plus 1 hour"

  # Nuxt hashed CSS/JS.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Images may be replaced under the same URL.
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/gif "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/avif "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 7 days"

  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# -----------------------------------------------------------------------------
# Cache-Control and security headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Dynamic Nuxt SSR routes: store only with revalidation.
  Header onsuccess unset Cache-Control
  Header always set Cache-Control "no-cache, must-revalidate"

  # Long-lived hashed assets.
  <FilesMatch "\.(?i:css|js|mjs|woff2?|ttf|otf|eot)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?i:ico|gif|jpe?g|png|webp|svg|avif)$">
    Header always set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(?i:xml)$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Agent-facing text files (llms.txt etc.).
  <FilesMatch "(?i)^llms\.txt$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
    Header always set Access-Control-Allow-Origin "*"
  </FilesMatch>

  <FilesMatch "\.(?i:txt|md)$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  <FilesMatch "(?i)^(?:sw|service-worker)\.js$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  Header onsuccess unset X-Content-Type-Options
  Header onsuccess unset X-Frame-Options
  Header onsuccess unset Referrer-Policy
  Header onsuccess unset Permissions-Policy
  Header onsuccess unset Strict-Transport-Security
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  Header onsuccess unset X-Powered-By
  Header always unset X-Powered-By

  # Add Content-Security-Policy only after testing analytics, demos, and Nuxt inline scripts.
</IfModule>

# -----------------------------------------------------------------------------
# Default text charset
# -----------------------------------------------------------------------------
AddDefaultCharset UTF-8
